<?xml version="1.0" encoding="utf-8"?>
<!-- The chart's card: solid, so point rings match it, with a white outline when the chart has focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/chart_surface" />
            <stroke android:width="2dp" android:color="@color/focus_ring" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/chart_surface" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
