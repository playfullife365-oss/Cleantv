<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The selected app's banner, blurred, filling the screen. -->
    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingLeft="@dimen/safe_horizontal"
            android:paddingRight="@dimen/safe_horizontal"
            android:paddingBottom="@dimen/safe_vertical">

            <!-- Top shelf: the selected app from the top row, large. Height and banner size are set in code. -->
            <FrameLayout
                android:id="@+id/shelf"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/shelf_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginBottom="28dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/shelf_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="2"
                        android:shadowColor="#80000000"
                        android:shadowDy="2"
                        android:shadowRadius="8"
                        android:textColor="@color/text_primary"
                        android:textSize="40sp" />

                    <TextView
                        android:id="@+id/shelf_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/shelf_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp"
                        android:visibility="invisible" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/shelf_banner"
                    android:layout_width="360dp"
                    android:layout_height="203dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="28dp"
                    android:alpha="0"
                    android:background="@drawable/shelf_card"
                    android:elevation="16dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <!-- Frosted dock with the top row of apps. -->
            <LinearLayout
                android:id="@+id/dock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/dock_panel"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/dock_padding"
                android:paddingTop="@dimen/dock_padding"
                android:paddingRight="@dimen/dock_padding"
                android:paddingBottom="4dp" />

            <LinearLayout
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingLeft="@dimen/dock_padding"
                android:paddingRight="@dimen/dock_padding" />
        </LinearLayout>
    </ScrollView>

    <!-- Fixed top-right corner: buttons and the time. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/safe_vertical"
        android:layout_marginEnd="@dimen/safe_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hidden_button"
            style="@style/Pill"
            android:text="@string/hidden_apps" />

        <TextView
            android:id="@+id/settings_button"
            style="@style/Pill"
            android:layout_marginStart="10dp"
            android:text="@string/settings" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:shadowColor="#80000000"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />
    </LinearLayout>
</FrameLayout>
